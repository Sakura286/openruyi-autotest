# Shared configuration for all test cases
# Sub-test directories inherit these automatically

# Default test framework
framework: shell

# Default test duration
duration: 5m

# Default contact
contact: QA Team <qa@example.com>

# Default enabled
enabled: true

# Default test execution path
path: /

# tier Tier explanation:
# tier: 0 = Smoke test (run on every commit)
# tier: 1 = core/Security test (daily build)
# tier: 2 = compatibility/performance/Reliability test (before release)